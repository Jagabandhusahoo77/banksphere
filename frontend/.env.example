# Base URLs for the backend services this app talks to.
# When running via docker/local/docker-compose.yml these are pre-set
# to reach the services through their published host ports.
VITE_CUSTOMER_SERVICE_URL=http://localhost:8081
VITE_ACCOUNT_SERVICE_URL=http://localhost:8082
VITE_TRANSACTION_SERVICE_URL=http://localhost:8083
VITE_BENEFICIARY_SERVICE_URL=http://localhost:8084
VITE_KYC_SERVICE_URL=http://localhost:8086
