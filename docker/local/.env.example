# Local-development-only defaults. Copy this file to .env in the same
# directory and adjust as needed. Never commit the real .env file or
# real credentials (see repo-root .gitignore).

DB_USERNAME=banksphere
DB_PASSWORD=banksphere_local_dev

# HMAC-SHA256 signing secret shared by customer-service and the three
# services that verify its tokens (account/transaction/beneficiary) — must
# be at least 32 bytes. This default is fine for local development only;
# generate a real random secret (e.g. `openssl rand -base64 48`) for any
# shared/deployed environment. See docs/security/jwt.md.
JWT_SECRET=banksphere-local-development-only-jwt-signing-secret-change-me-1234567890
# Access token lifetime in seconds. Only customer-service reads this (it's
# the only service that issues customer tokens).
JWT_EXPIRATION=3600

# A SEPARATE HMAC-SHA256 signing secret for employee-service, used ONLY by
# employee-service to issue and validate employee tokens — deliberately not
# JWT_SECRET above, so a customer token can never verify against the
# employee-portal's key or vice versa. See ADR-006, Decision 2.
EMPLOYEE_JWT_SECRET=banksphere-local-development-only-EMPLOYEE-jwt-signing-secret-change-me-987654321
# Employee sessions default to a shorter lifetime than customer sessions
# (30 min vs 1 hr) given the higher-privilege operational context.
EMPLOYEE_JWT_EXPIRATION=1800

# Phase 9D — customer OTP login + step-up authentication. All optional
# (application.yml already defaults every one of these); listed here so
# they're discoverable without reading the source. See ADR-009.
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_STEP_UP_EXPIRY_SECONDS=300
# Dev-only OTP inbox (GET /api/v1/auth/dev/otp-inbox) — the controller
# bean does not exist at all when this is false. MUST be false (or unset)
# outside local development.
OTP_DEV_INBOX_ENABLED=true
# Refresh token lifetime in seconds (default 14 days).
REFRESH_TOKEN_EXPIRY_SECONDS=1209600
# Local HTTP dev only — a browser never sends a Secure cookie over plain
# HTTP. MUST be true once served over HTTPS.
COOKIE_SECURE=false
# Transfers at or above this amount require step-up OTP verification.
# Illustrative BankSphere demo threshold, not a real regulatory figure.
STEP_UP_TRANSFER_THRESHOLD=50000.00

CUSTOMER_SERVICE_PORT=8081
ACCOUNT_SERVICE_PORT=8082
TRANSACTION_SERVICE_PORT=8083
BENEFICIARY_SERVICE_PORT=8084
EMPLOYEE_SERVICE_PORT=8085
KYC_SERVICE_PORT=8086
FRONTEND_PORT=5173
EMPLOYEE_PORTAL_PORT=5174
POSTGRES_PORT=5432
